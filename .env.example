# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Optional: `next start` port. NODE_ENV is set by Next.js itself (development for `npm run dev`, production for build/start).
PORT=3000

# Neon PostgreSQL connection string (Neon → your project → Connect). Use the POOLED one (host has "-pooler"),
# e.g. postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The Neon integration on Vercel fills DATABASE_URL in for you. Tables are created automatically on first use.
DATABASE_URL=

# The public URL of this website. Used to build the links in verification and reset emails.
# Local: http://localhost:3000   Production: https://www.bhagwantransport.com
CLIENT_URL=http://localhost:3000

# Two DIFFERENT random secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# The site and the API share one domain, so keep "strict". ("none" is only for a separate API domain and requires HTTPS.)
COOKIE_SAMESITE=strict

# Outgoing email (verification + password reset).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=a 16-letter Google "App password" (needs 2-Step Verification on), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Bhagwan Warehousing
SMTP_FROM_EMAIL=
